{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "vue",
    "vitest"
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-debugger": "error",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css"
        ]
      }
    ]
  },
  "ignorePatterns": [
    "dist",
    "coverage"
  ],
  "overrides": [
    {
      "files": [
        "vite.config.ts",
        "vitest.global-setup.ts"
      ],
      "env": {
        "node": true
      }
    }
  ]
}
